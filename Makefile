.PHONY: build test fmt fmt-check lint clean deploy-testnet check-stellar-cli fuzz load-test gas-report method-coverage help

LOAD_TEST_URL ?= http://localhost:4000

STELLAR_CLI_VERSION := 22.8.2

GAS_REPORT_OUT ?= gas-report.md

METHOD_COVERAGE_OUT ?= method-coverage.md

## build: Compile contracts to WASM (release)
build:
	stellar contract build

## test: Run all unit tests
test:
	cargo test

## fuzz: Run fuzz tests for 60 seconds minimum on governance contract
fuzz:
	@command -v cargo-fuzz >/dev/null 2>&1 || (echo "Installing cargo-fuzz..." && cargo install cargo-fuzz)
	@echo "Running fuzz targets for governance contract (60 seconds each)..."
	@timeout 60 cargo +nightly fuzz run fuzz_create_proposal || true
	@timeout 60 cargo +nightly fuzz run fuzz_cast_vote || true
	@timeout 60 cargo +nightly fuzz run fuzz_finalise || true
	@echo "Fuzz testing completed. Check for any panics or crashes above."

## load-test: Run k6 load test against the indexer API (LOAD_TEST_URL, default http://localhost:4000)
load-test:
	@command -v k6 >/dev/null 2>&1 || (echo "ERROR: k6 not found. See https://k6.io/docs/get-started/installation/" && exit 1)
	k6 run -e BASE_URL=$(LOAD_TEST_URL) tests/load/events.js

## gas-report: Generate a reproducible per-function gas report for key Soroban functions (GAS_REPORT_OUT, default gas-report.md)
gas-report:
	@command -v stellar >/dev/null 2>&1 || (echo "ERROR: stellar-cli not found. Install with: cargo install --locked stellar-cli@$(STELLAR_CLI_VERSION)" && exit 1)
	@echo "Generating gas report for create_proposal, cast_vote, finalise, execute..."
	@printf '# Soroban Gas Report\n\n' > $(GAS_REPORT_OUT)
	@printf 'Generated by `make gas-report` (reproducible).\n\n' >> $(GAS_REPORT_OUT)
	@printf '| Function | CPU Instructions | Memory (bytes) |\n' >> $(GAS_REPORT_OUT)
	@printf '| --- | --- | --- |\n' >> $(GAS_REPORT_OUT)
	@for fn in create_proposal cast_vote finalise execute; do \
		out=$$(stellar contract invoke --id $$CONTRACT_ID --fn $$fn -- --help 2>/dev/null || true); \
		cpu=$$(echo "$$out" | grep -oP 'cpu_instructions[^0-9]*\K[0-9]+' | head -1); \
		mem=$$(echo "$$out" | grep -oP 'memory_bytes[^0-9]*\K[0-9]+' | head -1); \
		printf '| %s | %s | %s |\n' "$$fn" "$${cpu:-n/a}" "$${mem:-n/a}" >> $(GAS_REPORT_OUT); \
	done
	@echo "Gas report written to $(GAS_REPORT_OUT)"

## method-coverage: Report each public contract function and whether it has a test (METHOD_COVERAGE_OUT, default method-coverage.md)
method-coverage:
	@printf '# Contract Method Coverage\n\n' > $(METHOD_COVERAGE_OUT)
	@printf 'Generated by `make method-coverage`.\n\n' >> $(METHOD_COVERAGE_OUT)
	@printf '| Contract | Public Function | Tested |\n' >> $(METHOD_COVERAGE_OUT)
	@printf '| --- | --- | --- |\n' >> $(METHOD_COVERAGE_OUT)
	@untested=0; \
	for src in $$(find contracts -name '*.rs' -not -path '*/target/*' 2>/dev/null); do \
		contract=$$(basename $$(dirname $$src)); \
		for fn in $$(grep -oP 'pub\s+fn\s+\K[a-zA-Z0-9_]+' $$src | sort -u); do \
			if grep -rqP "\b$$fn\s*\(" $$(find contracts -name '*.rs' -path '*test*' -not -path '*/target/*' 2>/dev/null) 2>/dev/null; then \
				tested=yes; \
			else \
				tested=no; untested=$$((untested + 1)); \
			fi; \
			printf '| %s | %s | %s |\n' "$$contract" "$$fn" "$$tested" >> $(METHOD_COVERAGE_OUT); \
		done; \
	done; \
	if [ "$$untested" -gt 0 ]; then \
		echo "Untested public functions ($$untested):"; \
		grep '| no |' $(METHOD_COVERAGE_OUT) || true; \
	else \
		echo "All public functions have tests."; \
	fi; \
	echo "Method coverage report written to $(METHOD_COVERAGE_OUT)"

## fmt: Auto-format all source files
fmt:
	cargo fmt

## fmt-check: Verify formatting without modifying files (used in CI)
fmt-check:
	cargo fmt --check

## lint: Run Clippy and fail on any warning
lint:
	cargo clippy --all-targets -- -D warnings

## clean: Remove build artefacts
clean:
	cargo clean

## deploy-testnet: Build and deploy both contracts to Stellar Testnet
deploy-testnet:
	NETWORK=testnet ./scripts/deploy.sh

## check-stellar-cli: Verify the installed stellar-cli matches the required version
check-stellar-cli:
	@INSTALLED=$$(stellar --version 2>/dev/null | grep -oP '\d+\.\d+\.\d+' | head -1); \
	if [ -z "$$INSTALLED" ]; then \
		echo "ERROR: stellar-cli not found. Install with:"; \
		echo "  cargo install --locked stellar-cli@$(STELLAR_CLI_VERSION)"; \
		exit 1; \
	elif [ "$$INSTALLED" != "$(STELLAR_CLI_VERSION)" ]; then \
		echo "ERROR: stellar-cli $$INSTALLED found, but $(STELLAR_CLI_VERSION) is required."; \
		echo "  cargo install --locked stellar-cli@$(STELLAR_CLI_VERSION)"; \
		exit 1; \
	else \
		echo "stellar-cli $(STELLAR_CLI_VERSION) OK"; \
	fi

## help: List all available targets
help:
	@grep -E '^## ' Makefile | sed 's/^## //' | column -t -s ':'
