# =============================================================================
# VoteChain Contracts — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values for your target environment.
# NEVER commit .env with real secrets.
#
# Every value below is either a non-secret default or an obvious placeholder.
# In staging/production, real secrets are injected from a vault / secrets
# manager (HashiCorp Vault, AWS Secrets Manager, Kubernetes Secrets) — never
# from a committed file.
#
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Network selection
# Accepted values: local | testnet | mainnet
# -----------------------------------------------------------------------------
NETWORK=local

# -----------------------------------------------------------------------------
# Backend CORS origins (comma-separated, exact origins without trailing slash)
# Required when NODE_ENV=production or NETWORK=staging/mainnet.
# Example: https://app.example.com,https://admin.example.com
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Stellar RPC endpoint for the selected network
# local   : http://localhost:8000
# testnet : https://soroban-testnet.stellar.org
# mainnet : https://soroban-mainnet.stellar.org  (or your own RPC node)
# -----------------------------------------------------------------------------
STELLAR_RPC_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Network passphrase — must match the target network exactly
# local   : Standalone Network ; February 2017
# testnet : Test SDF Network ; September 2015
# mainnet : Public Global Stellar Network ; September 2015
# -----------------------------------------------------------------------------
STELLAR_NETWORK_PASSPHRASE=Standalone Network ; February 2017

# -----------------------------------------------------------------------------
# Deployer / admin keypair
# STELLAR_SECRET_KEY : the secret key (S...) of the account that will deploy
#                      and administer the contracts.
# STELLAR_PUBLIC_KEY : the corresponding public key (G...).
#
# NEVER use the values below — they are placeholders, not real keys.
# Generate a real keypair with the Stellar SDK or CLI, e.g.:
#   stellar keys generate deployer --network testnet
#   stellar keys address deployer   # -> STELLAR_PUBLIC_KEY
#   stellar keys show deployer      # -> STELLAR_SECRET_KEY (keep out of git!)
# See https://developers.stellar.org/docs/build/guides/key-generation for
# all supported methods (CLI, JS SDK, Laboratory).
# -----------------------------------------------------------------------------
STELLAR_SECRET_KEY=SCHANGE_ME_THIS_IS_NOT_A_REAL_SECRET_KEY_REPLACE_ME
STELLAR_PUBLIC_KEY=GCHANGE_ME_THIS_IS_NOT_A_REAL_PUBLIC_KEY_REPLACE_ME

# -----------------------------------------------------------------------------
# Deployed contract addresses (populated after running scripts/deploy.sh)
# Leave as placeholders until deployment is complete.
# -----------------------------------------------------------------------------
GOVERNANCE_CONTRACT_ID=CCHANGE_ME_AFTER_RUNNING_SCRIPTS_DEPLOY_SH_REPLACE_ME
TOKEN_CONTRACT_ID=CCHANGE_ME_AFTER_RUNNING_SCRIPTS_DEPLOY_SH_REPLACE_ME

# -----------------------------------------------------------------------------
# Governance parameters (used by deploy scripts)
# MIN_PROPOSAL_BALANCE : minimum token balance required to create a proposal (stroops)
# PROPOSAL_COOLDOWN    : seconds a proposer must wait between proposals
# -----------------------------------------------------------------------------
MIN_PROPOSAL_BALANCE=0
PROPOSAL_COOLDOWN=0

# =============================================================================
# Frontend Configuration
# =============================================================================

# Stellar network for explorer links (frontend)
# Accepted values: testnet | public
# Determines which Stellar network to link to (stellar.expert)
VITE_STELLAR_NETWORK=testnet

# Custom Stellar Explorer domain (optional)
# Defaults to stellar.expert if not set
# Use custom domain for private/local Stellar networks
# Example: VITE_STELLAR_EXPLORER_DOMAIN=steexp.com
# VITE_STELLAR_EXPLORER_DOMAIN=stellar.expert

# -----------------------------------------------------------------------------
# Indexer database  ⚠️  SENSITIVE — contains credentials
# DATABASE_URL           : postgres://USER@HOST:5432/votechain
#                          Do NOT embed the password here in production: env
#                          vars are visible via /proc/<pid>/environ and may be
#                          captured by process listings or crash reports.
# DATABASE_PASSWORD_FILE : path to a file (e.g. a Docker/K8s secret) holding
#                          only the password. It is injected at startup and the
#                          indexer scrubs both variables from its environment.
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://votechain@localhost:5432/votechain
DATABASE_PASSWORD_FILE=/run/secrets/db_password

# -----------------------------------------------------------------------------
# Indexer — Horizon URL  ⚠️  SSRF PREVENTION
# HORIZON_URL              : Base URL of the Stellar Horizon (or Soroban RPC)
#                            endpoint the indexer polls for contract events.
#
#                            MUST be an https:// URL in production.
#                            The hostname MUST appear in ALLOWED_HORIZON_DOMAINS.
#                            Literal private/loopback IP addresses are always
#                            blocked (RFC 1918, RFC 4193, link-local, loopback)
#                            to prevent Server-Side Request Forgery (SSRF).
#
#                            ⚠️  DNS-resolved IPs are NOT validated at startup.
#                            Use a trusted network boundary (firewall/VPC egress
#                            rules) to restrict outbound traffic to known hosts.
#
# Examples:
#   testnet : https://horizon-testnet.stellar.org
#   mainnet : https://horizon.stellar.org
# -----------------------------------------------------------------------------
HORIZON_URL=https://horizon-testnet.stellar.org

# -----------------------------------------------------------------------------
# Indexer — Horizon domain allowlist
# ALLOWED_HORIZON_DOMAINS : Comma-separated list of hostnames the indexer is
#                           permitted to connect to.  The HORIZON_URL hostname
#                           must appear in this list or startup fails.
#
#                           Default (when unset):
#                             horizon-testnet.stellar.org,horizon.stellar.org
#
#                           Override for private/custom Horizon nodes:
#                             ALLOWED_HORIZON_DOMAINS=my-horizon.internal.corp
#
#                           Multiple values:
#                             ALLOWED_HORIZON_DOMAINS=horizon.stellar.org,horizon-testnet.stellar.org,my-node.example.com
# -----------------------------------------------------------------------------
# ALLOWED_HORIZON_DOMAINS=horizon-testnet.stellar.org,horizon.stellar.org

# -----------------------------------------------------------------------------
# Backend — Admin auth rate limiting / brute-force protection (issue #318)
# Applies to backend/src/middleware/adminAuth.ts, which gates all admin
# endpoints including API key management (backend/src/routes/keys.ts).
#
# ADMIN_AUTH_RATE_LIMIT        : max admin-auth attempts per IP per minute.
#                                Default: 5
# ADMIN_AUTH_BLOCK_THRESHOLD   : failed attempts within the block window that
#                                trigger an IP block. Default: 10
# ADMIN_AUTH_BLOCK_WINDOW_MS   : rolling window (ms) over which failed
#                                attempts are counted. Default: 300000 (5 min)
# ADMIN_AUTH_BLOCK_DURATION_MS : how long a tripped IP stays blocked.
#                                Default: 300000 (5 min)
# -----------------------------------------------------------------------------
# ADMIN_AUTH_RATE_LIMIT=5
# ADMIN_AUTH_BLOCK_THRESHOLD=10
# ADMIN_AUTH_BLOCK_WINDOW_MS=300000
# ADMIN_AUTH_BLOCK_DURATION_MS=300000

# =============================================================================
# Backend API (backend/)  — votechain-backend
# =============================================================================
# Every variable read by backend/src/** (app.ts and middleware/*), with the
# non-secret default the code falls back to. ⚠️  Values marked SENSITIVE must
# be injected from a vault / secrets manager in staging/production.

# -----------------------------------------------------------------------------
# Core server
# -----------------------------------------------------------------------------
# TCP port the HTTP API listens on.                           Default: 3001
PORT=3001

# Redis connection string — used for caching, rate-limit/abuse counters and
# API-key storage.  REQUIRED: the server exits at startup when this is unset.
# Format: redis://[USER:PASSWORD@]HOST:PORT[/DB]
# ⚠️  SENSITIVE once it carries credentials.
REDIS_URL=redis://localhost:6379

# Comma-separated browser origins allowed by CORS (scheme://host[:port], no
# trailing slash).  Requests without an Origin header are always allowed.
#                                            Default: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Node environment.  "production"/"staging" enable the strict CORS allowlist in
# backend/src/middleware/cors.ts (paired with CORS_ALLOWED_ORIGINS above).
NODE_ENV=development

# -----------------------------------------------------------------------------
# Admin authentication
# -----------------------------------------------------------------------------
# HMAC-SHA256 secret used to sign and verify admin JWTs.
# ⚠️  SENSITIVE — the dev fallback is the literal string "changeme"; always set
#     a long, randomly-generated value in production.
ADMIN_JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET

# Stellar address (G...) of the on-chain admin.  Must equal the `stellarAddress`
# claim in the JWT; there is no default, so admin auth fails closed when unset.
ADMIN_STELLAR_ADDRESS=GCHANGE_ME_ADMIN_STELLAR_ADDRESS

# Admin-auth brute-force limits are documented in the "Backend — Admin auth"
# block above (ADMIN_AUTH_*); they are optional and have safe defaults.

# Note: there is no "API key salt" / pepper variable to configure.  API keys
# are hashed with Argon2id, whose digest embeds a fresh random salt per key, so
# no shared secret is required (docs/security/SEC-015-api-key-argon2-hashing.md).

# -----------------------------------------------------------------------------
# Rate limiting (requests per minute; see docs/api-keys.md)
# -----------------------------------------------------------------------------
# Anonymous tier, per client IP.                              Default: 100 / 10
ANON_READ_LIMIT=100
ANON_WRITE_LIMIT=10
# API-key tier, per key.                                  Default: 1000 / 100
API_KEY_READ_LIMIT=1000
API_KEY_WRITE_LIMIT=100
# Combined read+write volume above which a key is auto-suspended.  Default: 1500
ABUSE_BURST_THRESHOLD=1500

# -----------------------------------------------------------------------------
# Redis cache TTLs (seconds)
# -----------------------------------------------------------------------------
# Proposal list cache TTL.                                    Default: 30
PROPOSAL_LIST_TTL=30
# Single proposal cache TTL.                                  Default: 10
PROPOSAL_ITEM_TTL=10
# Leaderboard read-cache TTL.                                 Default: 60
LEADERBOARD_CACHE_TTL=60

# -----------------------------------------------------------------------------
# Logging & request handling
# -----------------------------------------------------------------------------
# Minimum structured-log level: error | warn | info | debug.  Default: info
LOG_LEVEL=info
# Max accepted JSON request body size, express body-parser syntax.  Default: 100kb
JSON_BODY_LIMIT=100kb
# Per-dependency timeout (ms) for the /health and /ready probes.  Default: 2000
HEALTH_CHECK_TIMEOUT_MS=2000

# -----------------------------------------------------------------------------
# Backend also reads these variables declared elsewhere in this file:
#   DATABASE_URL         — Postgres URL; probed by the API /health check
#                          ("Indexer database" section above)
#   STELLAR_RPC_URL      — Soroban RPC endpoint, probed by /health (above)
#   CORS_ALLOWED_ORIGINS — allowlist for middleware/cors.ts (above)
#   NETWORK              — selects the Stellar network (top of this file)
# -----------------------------------------------------------------------------
